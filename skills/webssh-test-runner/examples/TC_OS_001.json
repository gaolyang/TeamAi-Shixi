{
  "testcase_id": "TC_OS_001",
  "title": "检查远端主机基本信息",
  "target": {
    "host": "192.168.63.132",
    "port": 22,
    "username": "root",
    "os": "Linux"
  },
  "steps": [
    {
      "step_id": "STEP_001",
      "title": "查看操作系统与内核",
      "action": "execute_command",
      "command": "uname -a",
      "timeout_ms": 30000,
      "expected": {
        "contains": "Linux"
      },
      "screenshot": true
    },
    {
      "step_id": "STEP_002",
      "title": "查看主机名",
      "action": "execute_command",
      "command": "hostname",
      "timeout_ms": 30000,
      "expected": {
        "regex": ".+"
      },
      "screenshot": true
    }
  ]
}
