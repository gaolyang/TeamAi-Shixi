# ── webssh-test-runner .env.example ─────────────────────────────────────
# Copy to `.env` and fill in real values. Do NOT commit `.env`.
# Never put real passwords in this file; secrets come from TEST_TARGET_PASSWORD.

# WebSSH2 service ---------------------------------------------------------
WEBSSH2_URL=http://127.0.0.1:2222/ssh
# Real install dir (auto-detected if left blank; see ENVIRONMENT.md)
WEBSSH2_HOME=
# Only start WebSSH2 if it is not already running AND this is true.
WEBSSH2_AUTO_START=false

# Playwright / browser ---------------------------------------------------
PLAYWRIGHT_HEADLESS=true
BROWSER_WIDTH=1440
BROWSER_HEIGHT=1000

# Connection (host/port/user are also overridable per-task) ---------------
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Prefer TEST_TARGET_PASSWORD env; only used when set.
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=

# Allowed target hosts (comma-separated). Empty = only host-format check,
# whitelist disabled (NOT recommended for unattended runs).
ALLOWED_HOSTS=

# Timing ----------------------------------------------------------------
COMMAND_TIMEOUT_MS=30000
PAGE_TIMEOUT_MS=20000

# Evidence ---------------------------------------------------------------
EVIDENCE_DIR=evidence
LOG_LEVEL=info
